# Plantilla de variables de entorno para talento-ecopetrol.
# Copiar a .env y rellenar con valores reales (NUNCA committear .env).
#
#   cp .env.example .env
#   chmod 600 .env
#   # editar con los valores reales

# Azure — Service Principal con permiso Log Analytics Reader sobre el workspace
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# AWX local (VM K3s) — para desarrollo L2
AWX_URL=https://192.168.250.20.nip.io
AWX_TOKEN=
AWX_ORG_ID=3
AWX_USER_ID=3

# Teams Incoming Webhook — para adaptive cards en L2.2 (pendiente)
TEAMS_WEBHOOK_URL=
