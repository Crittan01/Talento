# Perfil AZURE — apunta al AWX productivo en Azure (172.210.65.202).
# Uso:
#   cp .env.azure.example .env.azure
#   chmod 600 .env.azure
#   # editar con valores reales
#   make demo-azure        # activa este perfil y levanta dashboard
#
# Diferencias vs .env.local.example:
#   - AWX_URL apunta al AWX productivo en Azure
#   - AWX_TOKEN del realm productivo
#   - JT IDs Azure (32-43) en lugar de los locales (48-59)

# Azure — Service Principal (Log Analytics Reader). Foundry requiere AZURE_AI_API_KEY.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# API Key del proyecto Azure AI Foundry (proj-foundry-is2).
# Permite autenticar contra Foundry sin az login ni rol Azure AI Developer en el SP.
# Obtenla: AI Foundry Studio → tu proyecto → Settings → API keys
AZURE_AI_API_KEY=

# AWX productivo en Azure
AWX_URL=http://172.210.65.202.nip.io
AWX_TOKEN=
AWX_ORG_ID=4
AWX_USER_ID=4

# Job Template IDs — corresponden al AWX Azure productivo
AWX_JT_WORKSPACE_SNAPSHOT=32
AWX_JT_ERRORS_ANALYSIS=33
AWX_JT_SOX_AUDIT=34
AWX_JT_BRUTE_FORCE=35
AWX_JT_ACI_STATE=36
AWX_JT_APPSERVICE_STATE=37
AWX_JT_SQL_HEALTH=38
AWX_JT_FULL_HEALTH_CHECK=39
AWX_JT_ACI_RESTART=40
AWX_JT_ACI_STOP=41
AWX_JT_ACI_START=42
AWX_JT_APPSERVICE_RESTART=43

# Teams Incoming Webhook (opcional para adaptive cards)
TEAMS_WEBHOOK_URL=
