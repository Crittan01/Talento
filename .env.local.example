# Perfil LOCAL — apunta al AWX en la VM de desarrollo (192.168.250.20).
# Uso:
#   cp .env.local.example .env.local
#   chmod 600 .env.local
#   # editar con valores reales
#   make demo-local        # activa este perfil y levanta dashboard
#
# Diferencias vs .env.azure.example:
#   - AWX_URL apunta a la VM K3s local
#   - AWX_TOKEN del realm local
#   - JT IDs locales (48-59) en lugar de los Azure (32-43)

# Azure — Service Principal con permiso Log Analytics Reader sobre el workspace
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# AWX local (VM K3s) — desarrollo L2
AWX_URL=https://192.168.250.20.nip.io
AWX_TOKEN=
AWX_ORG_ID=3
AWX_USER_ID=3

# Job Template IDs — corresponden al AWX local
AWX_JT_WORKSPACE_SNAPSHOT=48
AWX_JT_ERRORS_ANALYSIS=49
AWX_JT_SOX_AUDIT=50
AWX_JT_BRUTE_FORCE=51
AWX_JT_ACI_STATE=52
AWX_JT_APPSERVICE_STATE=53
AWX_JT_SQL_HEALTH=54
AWX_JT_FULL_HEALTH_CHECK=55
AWX_JT_ACI_RESTART=56
AWX_JT_ACI_STOP=57
AWX_JT_ACI_START=58
AWX_JT_APPSERVICE_RESTART=59

# Teams Incoming Webhook (opcional para adaptive cards)
TEAMS_WEBHOOK_URL=
